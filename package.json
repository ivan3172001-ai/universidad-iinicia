{
  "name": "iinicia-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Plataforma Digital Universitaria IINICIA - React/Next.js + NestJS + Supabase + Moodle",
  "workspaces": [
    "apps/backend",
    "apps/frontend"
  ],
  "scripts": {
    "dev": "node scripts/start-all.mjs",
    "dev:backend": "npm --workspace=apps/backend run start:dev",
    "dev:frontend": "npm --workspace=apps/frontend run dev",
    "build:backend": "npm --workspace=apps/backend run build",
    "build:frontend": "npm --workspace=apps/frontend run build",
    "build": "npm run build:backend && npm run build:frontend"
  }
}
